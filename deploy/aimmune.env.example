# AImmune cottage env contract. Copy to /etc/aimmune/aimmune.env and chmod 0600.
# Do not commit secrets. systemd EnvironmentFile=-/etc/aimmune/aimmune.env
# (the leading '-' means a missing file is not fatal).

# --- site identity / state ------------------------------------------------
# Durable JSONL (receipts, queues, incidents, grants). Create 0700.
AIMMUNE_STATE_DIR=/var/lib/aimmune
# Envelope / receipt site_id. Must match Device.site_id and the hm_site_ token.
SITE_ID=net-tn-cottage
# AIMMUNE_SITE_ID=net-tn-cottage

# --- loop -----------------------------------------------------------------
# Seconds between detect+expiry+cycle-end sync ticks. Default 120.
AIMMUNE_CYCLE_SECONDS=120
# Feature-bundle window (seconds).
AIMMUNE_WINDOW_S=300

# --- Suricata EVE (cite OPNsense / proxmox-firewall; do not vendor) -------
# Typical Host path. Point at the live JSONL, not a copy inside this repo.
AIMMUNE_EVE_PATH=/var/log/suricata/eve.json
# AIMMUNE_WHITELIST_FILE=/etc/aimmune/whitelist.txt
# AIMMUNE_RULES_FILE=

# --- OPNsense alias_util (or lab mock) ------------------------------------
# Lab / CI: in-memory alias. Cottage with a real firewall: leave unset and
# set URL/key/secret. Executor does not reload the full ruleset.
AIMMUNE_EXEC_MOCK=0
AIMMUNE_ALIAS=ai_autoblock
AIMMUNE_RATE_LIMIT_B=30
# AIMMUNE_BLOCK_TTL_S=86400
# AIMMUNE_OPNSENSE_URL=https://opnsense.local
# AIMMUNE_OPNSENSE_KEY=
# AIMMUNE_OPNSENSE_SECRET=
# AIMMUNE_OPNSENSE_VERIFY=1
# Aliases: OPNSENSE_URL / OPNSENSE_KEY / OPNSENSE_SECRET

# --- plane (WireGuard, not Tailscale) -------------------------------------
# Leave unset + AIMMUNE_PLANE_REACHABLE=0 for offline-first cottage.
# Mint HM_SITE_TOKEN via Panopticon #38; store 0600. Confirm /site-tokens/me.
# PANOPTICON_BASE_URL=https://panopticon.wg.example
# HM_SITE_TOKEN=
AIMMUNE_PLANE_REACHABLE=0
AIMMUNE_PLANE_TIMEOUT_S=3
AIMMUNE_WAN_UP=1
AIMMUNE_SELL_STATE=off

# --- Hypermesh preempt / H4 owner.sock (cite hypermesh-host; no bake) -----
# Cycle-end covers auditor drain/poll, grant poll, incident sweep, and the
# thin site_defense hook. Do not add a second long-running preempt daemon.
# `aimmune preempt run` is on-demand CLI (Host RTT stays off the IDS loop).
# AIMMUNE_SITE_DEFENSE_PREEMPT=0
# AIMMUNE_HYPERMESH_DEVICE_IDS=
# AIMMUNE_HYPERMESH_LEASE_IDS=
# AIMMUNE_SELL_STATE_STALE_S=300
# AIMMUNE_LEASE_STOP_RATE=10
# AIMMUNE_JOB_POLL_TIMEOUT_S=30
# AIMMUNE_ALLOW_SELL_PAUSE_EXECUTE=1
# AIMMUNE_ALLOW_STOP_WHILE_SELLING=0
# Host H4 (plane-down): owner.sock + owner.token (0600).
# AIMMUNE_HOST_STATE_DIR=/var/lib/hypermesh
# HYPERMESH_STATE_DIR=/var/lib/hypermesh
# AIMMUNE_OWNER_SOCK=
# AIMMUNE_OWNER_TOKEN=

# --- UI (optional unit aimmune-ui.service) --------------------------------
# Required to serve. Sibling install: npm ci && npm run build in ui/.
# Bind 127.0.0.1 by default. AIMMUNE_UI_HOST=0.0.0.0 is opt-in only.
AIMMUNE_UI_TOKEN=
AIMMUNE_UI_HOST=127.0.0.1
AIMMUNE_UI_PORT=3000
# Next API spawns `python -m aimmune`. After pip install, any python3 works.
# AIMMUNE_PYTHON=python3
# AIMMUNE_REPO_ROOT=/usr/local/lib/aimmune

# --- triage / grants (slice 6–7) ------------------------------------------
# Privilege grants are SoT. Rails env is a deprecated test-only override.
AIMMUNE_RAILS_PROFILE=strict
# AIMMUNE_TRIAGE_ENGINES=
# AIMMUNE_TRIAGE_MODE=
# AIMMUNE_TRIAGE_FILE=
# AIMMUNE_RAILS_GRANT_ACTIVE=0

# --- iface pin (do not change SHA) ----------------------------------------
# Default: vendor/inference-iface @ 3621849bbf7c368b1d709356c465883144300208
# AIMMUNE_IFACE_PIN=/usr/local/lib/aimmune/vendor/inference-iface
