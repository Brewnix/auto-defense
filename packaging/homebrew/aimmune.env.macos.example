# AImmune Mac / Homebrew env. Mock + offline + loopback UI.
# Copy to $(brew --prefix)/etc/aimmune/aimmune.env and chmod 0600.
# Do not commit secrets. There is NO live OPNsense contain path on Mac.

# --- site identity / state ------------------------------------------------
# Formula also sets AIMMUNE_STATE_DIR on brew services (var/lib/aimmune).
# AIMMUNE_STATE_DIR=
SITE_ID=net-tn-cottage

# --- loop (mock / plane-down) ---------------------------------------------
AIMMUNE_CYCLE_SECONDS=120
AIMMUNE_WINDOW_S=300
AIMMUNE_EXEC_MOCK=1
AIMMUNE_PLANE_REACHABLE=0
AIMMUNE_WAN_UP=0
AIMMUNE_SELL_STATE=off
# Leave OPNsense URL/key/secret unset on Mac.
# AIMMUNE_OPNSENSE_URL=
# AIMMUNE_EVE_PATH=

# --- plane (do not enable from a Mac laptop) ------------------------------
# PANOPTICON_BASE_URL=
# HM_SITE_TOKEN=

# --- UI (loopback, or SSH-tunnel to a remote cottage) ---------------------
# Required to serve. Mint on the box; never bake onto a stick or into git.
AIMMUNE_UI_TOKEN=
AIMMUNE_UI_HOST=127.0.0.1
AIMMUNE_UI_PORT=3000
AIMMUNE_SIWE_DOMAIN=127.0.0.1
