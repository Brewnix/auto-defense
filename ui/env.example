# Copy values into the shell (do not commit secrets).
# AIMMUNE_UI_TOKEN is required to serve. Production fails closed if unset.
# Dual: token = serve door; human acts re-Check a verified SIWE address.
AIMMUNE_UI_TOKEN=
AIMMUNE_UI_SMOKE_PRINCIPAL=0xaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
AIMMUNE_OWNER_PRINCIPALS=0xaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
AIMMUNE_SIWE_DOMAIN=127.0.0.1
# AIMMUNE_SIWE_CHAIN_ID=1
# AIMMUNE_SIWE_URI=http://127.0.0.1:3000
# AIMMUNE_SIWE_SECRET=
# AIMMUNE_SIWE_TTL_S=43200
# Production without SIWE fails closed unless:
# AIMMUNE_UI_ALLOW_SMOKE_PRINCIPAL=1
# Optional MockCheck fixture JSON (objects + grants). Owners seed site:{id} and :ir.
# AIMMUNE_SOCIACL_FIXTURE=/tmp/sociacl-fixture.json
# Loopback is the default. Set 0.0.0.0 only as an explicit opt-in.
AIMMUNE_UI_HOST=127.0.0.1
AIMMUNE_UI_PORT=3000
AIMMUNE_STATE_DIR=/tmp/aimmune-state
SITE_ID=net-tn-cottage
AIMMUNE_PLANE_REACHABLE=0
# Machine doors unchanged:
# HM_SITE_TOKEN=hm_site_…
